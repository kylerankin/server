#!/usr/bin/bash
# bluefin-root-password-prompt — the first boot after a USB install asks for
# a root password on the monitor, and does not stop asking until root has one.
#
# Run by bluefin-root-password-prompt.service (first boot of a disk the USB
# installer wrote, which set the bluefin.prompt-root-password credential).
# The prompt is stock systemd-firstboot --prompt-root-password. Stock, an
# empty answer means "skip" and writes the locked, invalid "!*" to
# /etc/shadow; the unit runs on the first boot only, so root would stay
# locked for good, and with no other account nobody could log in at the
# console. So after each run this checks /etc/shadow, and while root still
# has no usable password it says why and asks again (--force, since root now
# counts as configured; --welcome=no keeps the explanation on screen).
#
# A passwd.hashed-password.root or passwd.plaintext-password.root credential
# answers the prompt instead; it is applied as given, also a deliberate "!*".
# So is systemd.firstboot=no on the kernel command line, which turns the
# prompt off. A run that leaves root without a password BLUEFIN_ROOT_PROMPT_TRIES
# times (default 20) fails the unit rather than spin.
#
# Test overrides: BLUEFIN_FIRSTBOOT (the systemd-firstboot command),
# BLUEFIN_SHADOW (/etc/shadow), BLUEFIN_CMDLINE (/proc/cmdline),
# BLUEFIN_ROOT_PROMPT_TRIES.

set -uo pipefail
export LC_ALL=C

PROG="${0##*/}"
firstboot="${BLUEFIN_FIRSTBOOT:-systemd-firstboot}"
shadow="${BLUEFIN_SHADOW:-/etc/shadow}"
cmdline="${BLUEFIN_CMDLINE:-/proc/cmdline}"
tries="${BLUEFIN_ROOT_PROMPT_TRIES:-20}"
creds="${CREDENTIALS_DIRECTORY:-}"

# root_has_password: root's shadow field holds a password hash, not an empty,
# locked ("!...") or invalid ("*...") one.
root_has_password() {
    local user hash _
    while IFS=: read -r user hash _; do
        [ "${user}" = root ] || continue
        case "${hash}" in
            '' | '!'* | '*'*) return 1 ;;
            *) return 0 ;;
        esac
    done < "${shadow}"
    return 1
}

for c in passwd.hashed-password.root passwd.plaintext-password.root; do
    if [ -n "${creds}" ] && [ -e "${creds}/${c}" ]; then
        exec "${firstboot}" --prompt-root-password --mute-console=yes
    fi
done
# systemd.firstboot=no on the kernel command line turns every prompt off.
if [[ " $(cat "${cmdline}" 2>/dev/null) " =~ [[:space:]]systemd\.firstboot=(0|no|false|off)[[:space:]] ]]; then
    exec "${firstboot}" --prompt-root-password --mute-console=yes
fi

args=()
for _ in $(seq "${tries}"); do
    "${firstboot}" "${args[@]}" --prompt-root-password --mute-console=yes || exit
    root_has_password && exit 0
    printf '%s\n' "" \
        "Root needs a password to log in at this console. An empty answer" \
        "would lock root for good, so it is not accepted here." ""
    args=(--force --welcome=no)
done
printf '%s: root still has no password after %s prompts, giving up\n' "${PROG}" "${tries}" >&2
exit 1
