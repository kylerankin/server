#!/usr/bin/bash
# bluefin-ignition-credentials — stage an Ignition config from system credentials.
#
# Bluefin Server's kernel command line is sealed into the signed UKI, so
# Ignition's ignition.config.url= karg cannot be used. Its config is taken
# from system credentials instead (SMBIOS type 11, QEMU fw_cfg, or
# /loader/credentials on the ESP), imported into $CREDENTIALS_DIRECTORY by
# ImportCredential= in bluefin-ignition-credentials.service:
#
#   ignition.config      an Ignition JSON (or, since Ignition 2.27, Butane
#                        YAML) config; copied verbatim
#   ignition.config.url  a URL (https, tftp, s3, gs, arn, data); a plain
#                        http:// URL is refused — the config is fetched and
#                        applied with no signature, see below. Wrapped in a
#                        config whose ignition.config.replace points at it, so
#                        ignition-fetch pulls the real config once the network
#                        is online
#
# If both are set, ignition.config wins and ignition.config.url is ignored.
#
# Without either credential, a network-booted node looks for bluefin-node.ign
# in the directory it booted from, as reported by /usr/libexec/bluefin-boot-origin:
# the UEFI HTTP boot URL (StubDeviceURL EFI variable), the same way the initrd
# derives the /usr image URL, or, for a node chainloaded by iPXE, the explicit
# https URL its boot server (Booty) passes in rd.systemd.pull. If the boot
# server has one, it is fetched here and staged; otherwise Ignition is skipped.
#
# Trust. Every other artifact a network-booted node consumes is verified: the
# /usr image and DDI are pulled with verify=signature, and sysupdate verifies
# SHA256SUMS.gpg against the import keyring. The Ignition config was the one
# exception — fetched over the (often plain-HTTP) provisioning network and
# applied with no signature or hash, so an on-path attacker could swap it for
# root SSH keys or systemd units and get root despite the signed boot chain.
# Two things close that here:
#
#   * A plain http:// origin is refused, automatic or credential. The probe
#     requires https, the same transport the image pull already demands.
#   * If the boot server publishes a detached signature, bluefin-node.ign.gpg,
#     it is verified with gpgv against the import keyring (the same root as
#     the image pull) and the verified bytes are staged inline at
#     /run/ignition/user.ign, so Ignition applies exactly what was signed
#     instead of re-fetching an unauthenticated copy. A signature that does
#     not verify is refused.
#
# Signing bluefin-node.ign is a Booty-side change (serve the .gpg next to the
# per-MAC config); until then an https server without a .gpg still stages the
# config unauthenticated, which is a trust-network-only deployment — see
# docs/skills/booty-integration.md. Refusing unsigned https configs by default
# is the intended end-state and needs that coordination (issue #284).
#
# Output: /run/ignition/user.ign (absent when there is nothing to apply), the
# highest-priority user config path that Ignition's "system" provider reads
# before the platform provider.
#
# Deliberately bash builtins, coreutils and curl only.

set -euo pipefail
export LC_ALL=C

PROG="${0##*/}"
# Output path is fixed by Ignition's contract: /run/ignition/user.ign is the
# highest-priority user config path the "system" provider reads. BLUEFIN_IGNITION_OUT
# overrides it for the unit test (same seam bluefin-boot-deadline uses for its
# reboot sentinel); it is never set in the initrd.
OUT="${BLUEFIN_IGNITION_OUT:-/run/ignition/user.ign}"
# Newest stable config spec in Ignition v2.27.0 (config/v3_6). A replaced
# config may use any spec version Ignition accepts.
STUB_VERSION=3.6.0
# A scheme, then no whitespace, control characters, '"' or '\': the value is
# pasted into a JSON string unescaped, so refuse anything that would need it.
URL_RE='^[A-Za-z][A-Za-z0-9+.-]*:[^[:space:][:cntrl:]"\]+$'

log() { printf '%s: %s\n' "${PROG}" "$*" >&2; }
die() { log "$*"; exit 1; }

# systemd reads /etc/systemd/import-pubring.pgp before the vendor keyring; the
# initrd ships it here (os-sysupdate-keys.bst), the same keyring the image pull
# verifies SHA256SUMS.gpg against. BLUEFIN_KEYRING overrides the path for the
# unit test (same seam bluefin-diskless-update-check uses for BLUEFIN_IMPORT_KEYRING).
keyring="${BLUEFIN_KEYRING:-/usr/lib/systemd/import-pubring.pgp}"
[ -e /etc/systemd/import-pubring.pgp ] && keyring=/etc/systemd/import-pubring.pgp

NODE_CONFIG=bluefin-node.ign
BOOT_ORIGIN="${BLUEFIN_BOOT_ORIGIN:-/usr/libexec/bluefin-boot-origin}"

creds="${CREDENTIALS_DIRECTORY:-/nonexistent}"
config="${creds}/ignition.config"
url_cred="${creds}/ignition.config.url"

# Stage the config bytes already in <file> as the inline user config.
stage_inline() { mv -f "$1" "${OUT}"; }

# Wrap a URL in a stub config whose ignition.config.replace points at it, so
# ignition-fetch pulls the real config once the network is online. Plain
# http:// is refused: the config would be fetched and applied with no
# signature on the provisioning network.
stage_url() {
  case "$1" in
    http://*) die "refusing http:// Ignition config URL (fetched and applied with no signature): $1" ;;
  esac
  [[ "$1" =~ ${URL_RE} ]] || die "invalid Ignition config URL: $(printf '%q' "$1")"
  printf '{"ignition":{"version":"%s","config":{"replace":{"source":"%s"}}}}\n' \
    "${STUB_VERSION}" "$1" > "${OUT}.tmp"
}

# Verify <signature> against <config> with gpgv against the import keyring.
# Returns 0 on a valid signature, non-zero otherwise.
verify_sig() {
  local sig="$1" cfg="$2" gnupg
  gnupg="$(mktemp -d)"
  chmod 0700 "${gnupg}"
  if GNUPGHOME="${gnupg}" gpgv --keyring "${keyring}" "${sig}" "${cfg}" >/dev/null 2>&1; then
    rm -rf "${gnupg}"
    return 0
  fi
  rm -rf "${gnupg}"
  return 1
}

umask 077
mkdir -p "${OUT%/*}"

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

if [ -s "${config}" ]; then
  [ ! -s "${url_cred}" ] || log "ignition.config and ignition.config.url both set; ignoring ignition.config.url"
  cp "${config}" "${OUT}.tmp"
  stage_inline "${OUT}.tmp"
  log "staged inline config from credential ignition.config"
elif [ -s "${url_cred}" ]; then
  url="$(<"${url_cred}")"
  stage_url "${url}"
  stage_inline "${OUT}.tmp"
  log "staged config.replace of ${url} (credential ignition.config.url)"
else
  # Network boot: bluefin-node.ign next to the UKI.
  if ! boot_url="$("${BOOT_ORIGIN}")"; then
    log "no Ignition credential and no network boot origin; nothing to apply"
    exit 0
  fi
  config_url="${boot_url%/*}/${NODE_CONFIG}"
  sig_url="${config_url}.gpg"
  case "${boot_url}" in
    http://*) die "refusing http:// boot origin ${boot_url}; ${NODE_CONFIG} is fetched and applied with no signature" ;;
  esac
  # Look for the config next to the UKI. A missing or unreachable config is not
  # an error — it just means there is nothing to apply.
  if ! curl -sfI --retry 3 --connect-timeout 10 --max-time 30 "${config_url}"; then
    log "no ${NODE_CONFIG} next to ${boot_url}; nothing to apply"
    exit 0
  fi
  # Fetch the config body. If the boot server publishes a detached signature,
  # verify it and apply the verified bytes inline, so Ignition applies exactly
  # what was signed instead of re-fetching an unauthenticated copy. A signature
  # we cannot verify is refused — a tampered config must not be trusted just
  # because https loaded it.
  curl -fsS --retry 3 --connect-timeout 10 --max-time 30 \
    -o "${tmp}/${NODE_CONFIG}" "${config_url}"
  sig_fetched=0
  curl -fsS --retry 3 --connect-timeout 10 --max-time 30 \
    -o "${tmp}/${NODE_CONFIG}.gpg" "${sig_url}" 2>/dev/null && sig_fetched=1
  if [ "${sig_fetched}" -eq 1 ] && verify_sig "${tmp}/${NODE_CONFIG}.gpg" "${tmp}/${NODE_CONFIG}"; then
    stage_inline "${tmp}/${NODE_CONFIG}"
    log "staged authenticated ${NODE_CONFIG} from ${config_url} (gpgv-verified)"
  elif [ "${sig_fetched}" -eq 1 ]; then
    die "signature for ${config_url} does not verify against ${keyring}; refusing to apply ${NODE_CONFIG}"
  else
    # No signature served yet: an https-only deployment without a .gpg still
    # provisions, but the config is unauthenticated — a trust-network-only
    # deployment until Booty signs the per-MAC config (see
    # docs/skills/booty-integration.md).
    log "${NODE_CONFIG} from ${config_url} has no verifying signature; staged over https UNAUTHENTICATED — serve ${NODE_CONFIG}.gpg to authenticate"
    stage_url "${config_url}"
    stage_inline "${OUT}.tmp"
  fi
fi
